# Copy this file to .env and fill in only what you need. Never commit .env.
# All notebooks run WITHOUT these keys; keys only enable the optional real-model cells.
OPENAI_API_KEY=your-key-here
ANTHROPIC_API_KEY=your-key-here
# Model names change often - check the providers' model pages and update these.
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-opus-5-5
CREW_MODEL=anthropic/claude-opus-5-5
