# Copy this file to ".env" and fill in real values. NEVER commit the real .env file.
APP_ENV=dev
# Leave empty to use the offline stand-in model
ANTHROPIC_API_KEY=your-key-here
LLM_MODEL=claude-haiku-latest
PRICE_IN_PER_M=1.0
PRICE_OUT_PER_M=5.0
# Optional: Langfuse observability (cloud or self-hosted)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
# Where the UI finds the API
API_URL=http://127.0.0.1:8000
