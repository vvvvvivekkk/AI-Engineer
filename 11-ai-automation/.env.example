# Copy to .env and fill in only what you need. Never commit .env.
# Notebooks run WITHOUT any of these.
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-opus-5-5
# Shared secret for signing/verifying webhooks (code/webhook_receiver.py and send_test_webhook.py)
WEBHOOK_SECRET=change-me-to-a-long-random-string
# Where send_test_webhook.py posts (your FastAPI receiver or an n8n webhook URL)
TARGET_URL=http://127.0.0.1:8000/webhook/ticket
# Feed used by python_automation.py
FEED_URL=https://hnrss.org/frontpage
