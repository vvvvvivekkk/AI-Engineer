# Copy to .env and edit. Never commit .env (it may hold keys).

# Zero-shot methods used by main.py are chosen with --zero-shot (nli, sst2, llm).
# Models for the nli and sst2 methods (Hugging Face names):
NLI_MODEL=MoritzLaurer/xtremedistil-l6-h256-zeroshot-v1.1-all-33
SST2_MODEL=distilbert-base-uncased-finetuned-sst-2-english

# Provider for the "llm" method: local | ollama | anthropic | openai
LLM_PROVIDER=local
LOCAL_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini

TORCH_THREADS=2
