# Copy to .env and edit. Never commit your real .env.
# PLANNER: auto (scripted when LLM_PROVIDER=local, native tool calling otherwise) | scripted | llm
PLANNER=auto
# local | ollama | anthropic | openai
LLM_PROVIDER=local
LOCAL_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct
OLLAMA_HOST=http://localhost:11434
# needs a model that supports tools, e.g. qwen2.5:1.5b, qwen2.5:7b or llama3.2:3b
OLLAMA_MODEL=qwen2.5:1.5b
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini
