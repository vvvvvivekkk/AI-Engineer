# Copy to .env and edit. Never commit your real .env.
# rules = regex/keyword extractor (default, no model) | llm = LLM JSON extraction with Pydantic validation
EXTRACT_METHOD=rules
QUEUE_DB=data/queue.db
# Which LLM is used when EXTRACT_METHOD=llm: local | ollama | anthropic | openai
LLM_PROVIDER=local
LOCAL_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini
