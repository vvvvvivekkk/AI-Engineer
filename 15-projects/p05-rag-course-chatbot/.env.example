# Copy to .env and edit. Never commit .env (it may hold keys).

# What to index: repo (every *.md in the curriculum) | sample (data/sample_docs) | /path/to/folder
DOCS=repo
DOCS_GLOB=**/*.md
CHUNK_WORDS=180
CHUNK_OVERLAP=30
TOP_K=4
MIN_SCORE=0.25
RELEVANCE_GAP=0.15
USE_RERANKER=false
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# How answers are written: llm | extractive (no LLM, instant, quotes the notes)
ANSWER_MODE=llm
# How follow-up questions are rewritten: rules | llm
REWRITE_MODE=rules
MEMORY_TURNS=3

# Which LLM writes answers when ANSWER_MODE=llm: local | ollama | anthropic | openai
LLM_PROVIDER=local
LOCAL_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini

GRADIO_SHARE=false
TORCH_THREADS=2
