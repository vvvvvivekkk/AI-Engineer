# Copy this file to .env and replace the placeholders with your own keys.
# NEVER commit .env to git. Only this example file (with placeholders) is safe to share.

OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here

# Optional: override the example model names used in this module.
# Model names change often - check each provider's models page.
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_MODEL=gemini-flash-latest

# Optional: local Ollama server and model
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
