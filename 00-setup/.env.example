# .env.example - a SAFE template. Commit this file; never commit your real .env.
#
# How to use:
#   1. Copy this file and name the copy ".env"
#        macOS / Linux:      cp .env.example .env
#        Windows PowerShell: Copy-Item .env.example .env
#   2. Open .env and replace each placeholder with your own key.
#   3. Make sure ".env" is listed in .gitignore (it is in this repo).
#
# Rules: one NAME=value per line, no spaces around "=", no quotes needed.
# Leave a line as a placeholder if you do not have that key yet - the course
# notebooks fall back to offline stand-ins when a key is missing.

# OpenAI - https://platform.openai.com (API keys page)
OPENAI_API_KEY=your-key-here

# Anthropic (Claude) - https://console.anthropic.com (API keys page)
ANTHROPIC_API_KEY=your-key-here

# Google Gemini - https://aistudio.google.com (Get API key)
GEMINI_API_KEY=your-key-here

# Hugging Face - huggingface.co -> Settings -> Access Tokens
HF_TOKEN=your-token-here

# Not a secret: an example of a normal setting you might also keep here
APP_ENV=development
